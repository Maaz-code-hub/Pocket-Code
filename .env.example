# Copy this file to .env and fill it in.

# --- Supabase Storage (recommended) ---
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the SECRET key (sb_secret_...) or the legacy service_role key.
# Never put this key in frontend code; it stays on the server only.
SUPABASE_SERVICE_KEY=
# Bucket is created automatically (private) on first start.
SUPABASE_BUCKET=code-saver

# --- General ---
PORT=3000
# Supabase free plan allows up to 50 MB per file.
MAX_UPLOAD_MB=50
# Size shown in the storage meter; uploads stop when it's full. Free plan = 1 GB.
STORAGE_LIMIT_MB=1024

# Optional: view-only mode. Anyone can browse and download, but uploading,
# editing, deleting and the Trash need this key (asked once per browser).
EDIT_KEY=
# Optional: require a key just to open the site. Leave empty for no lock.
ACCESS_KEY=

# If SUPABASE_URL is empty, files are stored on local disk here instead:
# DATA_DIR=./data

# --- Redis Caching (speeds up requests & reduces Supabase DB load) ---
# Set your Redis URL below (supports redis:// and rediss:// for Upstash, Redis Cloud, etc.)
# If left empty, the server automatically uses an in-memory cache fallback.
REDIS_URL=
# Cache expiration in hours (default: 12 hours). Database will only be queried once every 12h.
CACHE_TTL_HOURS=12
# Max file size in MB to cache in Redis for instant downloads/previews (default: 5 MB)
CACHE_FILE_MAX_MB=5

# --- Supabase Keep-Alive (prevents 7-day auto-pause on free tier) ---
# How often to auto-request Supabase in hours (default: 6 hours). Set 0 to disable.
KEEP_ALIVE_HOURS=6
